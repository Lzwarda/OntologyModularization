    <Class rdf:about="&po;Fruit">
        <rdfs:label rdf:datatype="&xsd;string">fruit</rdfs:label>
        <rdfs:subClassOf rdf:resource="&po;multi-tissuePlantStructure"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;length"/>
                <someValuesFrom rdf:resource="&xsd;string"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;has_surface"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Surface"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;has_color"/>
                <someValuesFrom rdf:resource="&PATO;Color"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;fruit_species"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Species"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&po;develops_from"/>
                <someValuesFrom rdf:resource="&po;Gynoecium"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;width"/>
                <someValuesFrom rdf:resource="&xsd;string"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:comment rdf:datatype="&xsd;string">A fruit may contain additional plant structures (PO:0009011) that were part of a flower (PO:0009046) and mature along with the gynoecium, such as a receptacle (PO:0009064). A fruit may develop without fertilization in cases of parthenocarpy, apomixis, or other hormone-induced conditions and may not always contain seeds. Fruits only occur in angiosperms.</rdfs:comment>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A multi-tissue plant structure (PO:0025496) that develops from a gynoecium (PO:0009062) and may have as parts one or more seeds (PO:0009010).</plantbiodiversity:definition>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">accessory fruit</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">achene</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">acorn</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">aggregate fruit</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">akene</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">anthocarp</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">berry</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">capsule</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">caryopsides</plantbiodiversity:has_narrow_synonym>
