    <!-- http://www.stkos-ontology/domain/plantbiodiversity#seamount -->

    <NamedIndividual rdf:about="&plantbiodiversity;seamount">
        <rdf:type rdf:resource="&envo;PhysiographicFeature"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A mountain rising from the ocean seafloor that does not reach to the water&apos;s surface (sea level), and thus is not an island. Typically formed from volcanoes that rise abruptly and are usually found rising from a seafloor of 1,000 - 4,000 meters depth. Independent features that rise to at least 1,000 meters above the seafloor.</plantbiodiversity:definition>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">Seamount</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">hill</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">hills</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">knoll</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">knolls</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mesa</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mound</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mount</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_broad_synonym rdf:datatype="&xsd;string">mount</plantbiodiversity:has_broad_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mountain</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">mountains</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">peak</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">peaks</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">range</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">sea mount</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">sea-mount</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">seaknoll</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">seakpeak</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">seamount</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">submarine volcano</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">undersea hill</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">undersea knoll</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">undersea mound</plantbiodiversity:has_related_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">海底山、海山</rdfs:comment>
    </NamedIndividual>
    


