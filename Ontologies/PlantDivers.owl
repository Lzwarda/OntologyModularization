        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">trench</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">vale</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">valleys</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">water gap</plantbiodiversity:has_related_synonym>
