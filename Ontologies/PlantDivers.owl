    <!-- http://www.stkos-ontology/domain/plantbiodiversity#butte -->

    <NamedIndividual rdf:about="&plantbiodiversity;butte">
        <rdf:type rdf:resource="&envo;PhysiographicFeature"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">An isolated hill with steep sides and a small flat top, smaller than mesas and plateaus. Buttes are formed by erosion when a cap of hard rock, usually of volcanic origin, covers a layer of softer rock that is easily worn away. This hard rock avoids erosion while the rock around it wears down.</plantbiodiversity:definition>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">butte</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_broad_synonym rdf:datatype="&xsd;string">plateau</plantbiodiversity:has_broad_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">孤山、地垛、孤丘、小方丘</rdfs:comment>
    </NamedIndividual>
    


