        <rdf:type rdf:resource="&envo;PhysiographicFeature"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">An arid terrain with clay-rich soil that has been extensively eroded by wind and water.</plantbiodiversity:definition>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">badlands</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_broad_synonym rdf:datatype="&xsd;string">barren land</plantbiodiversity:has_broad_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">荒原、崎岖地</rdfs:comment>
    </NamedIndividual>
    


