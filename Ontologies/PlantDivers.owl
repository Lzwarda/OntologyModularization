    <!-- http://www.stkos-ontology/domain/plantbiodiversity#animal-associated_habitat -->

    <NamedIndividual rdf:about="&plantbiodiversity;animal-associated_habitat">
        <rdf:type rdf:resource="&envo;Organism-associated"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A habitat that is in or on a living animal. Here &quot;animal&quot; denotes an individual of a species that is a sub-taxon of NCBITaxon:33208.</plantbiodiversity:definition>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">metazoan-associated habitat</plantbiodiversity:has_exact_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">动物相关联的栖息地</rdfs:comment>
    </NamedIndividual>
    


