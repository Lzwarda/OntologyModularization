    <!-- http://www.stkos-ontology/domain/plantbiodiversity#mountain -->

    <NamedIndividual rdf:about="&plantbiodiversity;mountain">
        <rdf:type rdf:resource="&envo;PhysiographicFeature"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A landform that extends above the surrounding terrain in a limited area. A mountain is generally steeper than a hill, but there is no universally accepted standard definition for the height of a mountain or a hill although a mountain usually has an identifiable summit and a local relief of more than 300m.</plantbiodiversity:definition>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">Mountain</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">cerro</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">cordillera</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">foothill</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">knoll</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mound</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mount</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">mountains</plantbiodiversity:has_related_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">山地</rdfs:comment>
    </NamedIndividual>
    


