    <Class rdf:about="&po;Seed">
        <rdfs:label rdf:datatype="&xsd;string">seed</rdfs:label>
        <rdfs:subClassOf rdf:resource="&po;multi-tissuePlantStructure"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;has_color"/>
                <someValuesFrom rdf:resource="&PATO;Color"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&po;develops_from"/>
                <someValuesFrom rdf:resource="&po;PlantOvule"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;has_surface"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Surface"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
