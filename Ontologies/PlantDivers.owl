        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">coenocarp</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">cypsela</plantbiodiversity:has_narrow_synonym>
