    <!-- http://purl.obolibrary.org/obo/po#VascularLeaf -->

    <Class rdf:about="&po;VascularLeaf">
        <rdfs:label rdf:datatype="&xsd;string">vascular leaf</rdfs:label>
        <rdfs:subClassOf rdf:resource="&po;Leaf"/>
        <rdfs:comment rdf:datatype="&xsd;string">Has vascular tissue. From APweb Glossary: In angiosperms, commonly thought of as one of the three basic parts of the seed plant body, a structure usually of determinate growth, without secondary thickening, and of superficial origin, often flattened and photosynthetic in part, and in the axil of which is found a bud. Occurs in the sporophytic phase of a plant life cycle.</rdfs:comment>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">ascidia</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">ascidium</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">crozier</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">fiddlehead</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">foliage leaf</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">frond</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">hoja vascular (Spanish)</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">leaf, vascular</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">macrophyll</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">megaphyll</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">needle-like leaf</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">pitcher</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">pitcher-blade</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">scale-like leaf</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">sterile frond</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_narrow_synonym rdf:datatype="&xsd;string">trophophyll</plantbiodiversity:has_narrow_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">vascular leaves</plantbiodiversity:has_exact_synonym>
        <plantbiodiversity:has_exact_synonym rdf:datatype="&xsd;string">維管束のある葉, または維管束植物の葉 (Japanese)</plantbiodiversity:has_exact_synonym>
    </Class>
    


