    </NamedIndividual>
    


    <!-- http://www.stkos-ontology/domain/plantbiodiversity#arete -->

    <NamedIndividual rdf:about="&plantbiodiversity;arete">
        <rdf:type rdf:resource="&envo;PhysiographicFeature"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A thin, almost knife-like, ridge of rock which is typically formed when two glaciers erode parallel U-shaped valleys. The arte is a thin ridge of rock that is left separating the two valleys. Artes can also form when two glacial cirques erode towards one another, although frequently this results in a saddle-shaped pass, called a col.</plantbiodiversity:definition>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">ridge</plantbiodiversity:has_related_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">冰脊、刃脊</rdfs:comment>
    </NamedIndividual>
    


    <!-- http://www.stkos-ontology/domain/plantbiodiversity#arid -->

    <NamedIndividual rdf:about="&plantbiodiversity;arid">
        <rdf:type rdf:resource="&envo;ClimateRegion"/>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">An arid condition is an environmental condition in which annual precipitation is less than half of annual potential evapotranspiration.</plantbiodiversity:definition>
        <rdfs:comment rdf:datatype="&xsd;string">干旱的、干燥的、贫瘠的</rdfs:comment>
    </NamedIndividual>
    


    <!-- http://www.stkos-ontology/domain/plantbiodiversity#auriculate -->

    <NamedIndividual rdf:about="&plantbiodiversity;auriculate">
        <rdf:type rdf:resource="&po;LeafBase"/>
