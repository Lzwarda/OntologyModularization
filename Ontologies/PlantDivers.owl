        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">grassland</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">prairie</plantbiodiversity:has_related_synonym>
        <plantbiodiversity:has_related_synonym rdf:datatype="&xsd;string">steppe</plantbiodiversity:has_related_synonym>
        <rdfs:comment rdf:datatype="&xsd;string">草地生态系统</rdfs:comment>
    </Class>
    


    <!-- http://purl.obolibrary.org/obo/envo#Habitat -->

    <Class rdf:about="&envo;Habitat">
        <rdfs:label rdf:datatype="&xsd;string">habitat</rdfs:label>
        <rdfs:subClassOf rdf:resource="&bfo;SpatialRegion"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;longitude"/>
                <someValuesFrom rdf:resource="&xsd;string"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;contains_species"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Species"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;latitude"/>
                <someValuesFrom rdf:resource="&xsd;string"/>
            </Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;contains_biome"/>
                <someValuesFrom rdf:resource="&envo;Biome"/>
            </Restriction>
        </rdfs:subClassOf>
    </Class>
    


    <!-- http://purl.obolibrary.org/obo/envo#HighOsmolarity -->

    <Class rdf:about="&envo;HighOsmolarity">
        <rdfs:label rdf:datatype="&xsd;string">high osmolarity</rdfs:label>
        <rdfs:subClassOf rdf:resource="&envo;Habitat"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;contains_species"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Species"/>
            </Restriction>
        </rdfs:subClassOf>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A habitat characterized by a high osmolarity, typically the result of a high concentration of sugars. Inhabited by osmophilic organisms.</plantbiodiversity:definition>
        <rdfs:comment rdf:datatype="&xsd;string">高渗透性栖息地</rdfs:comment>
    </Class>
    


    <!-- http://purl.obolibrary.org/obo/envo#HighPressure -->

    <Class rdf:about="&envo;HighPressure">
        <rdfs:label rdf:datatype="&xsd;string">high pressure</rdfs:label>
        <rdfs:subClassOf rdf:resource="&envo;Habitat"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;contains_species"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Species"/>
            </Restriction>
        </rdfs:subClassOf>
        <plantbiodiversity:definition rdf:datatype="&xsd;string">A habitat characterized by high gas or liquid pressure, inhabited by barophilic (piezophilic) organisms.</plantbiodiversity:definition>
        <rdfs:comment rdf:datatype="&xsd;string">高压栖息地</rdfs:comment>
    </Class>
    


    <!-- http://purl.obolibrary.org/obo/envo#HighTemperature -->

    <Class rdf:about="&envo;HighTemperature">
        <rdfs:label rdf:datatype="&xsd;string">high temperature</rdfs:label>
        <rdfs:subClassOf rdf:resource="&envo;Habitat"/>
        <rdfs:subClassOf>
            <Restriction>
                <onProperty rdf:resource="&plantbiodiversity;contains_species"/>
                <someValuesFrom rdf:resource="&plantbiodiversity;Species"/>
            </Restriction>
